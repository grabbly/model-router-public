# model-router configuration. Copy to `.env` and fill in. NEVER commit `.env`.
#
# Names are the neutral ROUTER_* set. Every one still falls back to its legacy
# PF_* name (shown in comments) so an existing the portal .env keeps working
# during the split — drop the legacy names once all deployments set ROUTER_*.

# ── Server ───────────────────────────────────────────────────────────
PORT=4200
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production

# ── Auth ─────────────────────────────────────────────────────────────
# Service key: the shared bearer our own projects send as `Authorization`.
ROUTER_SERVICE_API_KEY=            # legacy: PF_SERVICE_API_KEY
# HMAC secret for per-tenant tokens (`pft_<tenantId>.<mac>`). Defaults to the
# service key if unset. Give external projects their own tenant token minted
# from this secret rather than the raw service key.
ROUTER_TENANT_TOKEN_SECRET=        # legacy: PF_TENANT_TOKEN_SECRET

# ── Upstreams ────────────────────────────────────────────────────────
# backend2 gate (Gemini/Claude proxy). Prod value:
#   https://backend2.example.com/gemini/v1
ROUTER_BACKEND2_BASE_URL=          # legacy: PF_BACKEND2_BASE_URL
# ollama.com cloud fallback.
ROUTER_CLOUD_BASE_URL=https://ollama.com/v1   # legacy: PF_CLOUD_BASE_URL
# Local GPU Ollama. On prod-host reach it via backend2's gate:
#   https://backend2.example.com/ollama/v1
# On dev LAN the default http://localhost:11434/v1 applies.
ROUTER_OLLAMA_BASE_URL=            # legacy: PF_OLLAMA_BASE_URL

# ── Upstream credentials (names of the env vars holding the secrets) ──
# The backend2 gate token. The router reads whichever env var this names.
ROUTER_BACKEND2_TOKEN_ENV=PF_MODELS_TOKEN
PF_MODELS_TOKEN=                   # the actual backend2 bearer token
# ollama.com cloud key.
OLLAMA_API_KEY=
# MiniMax native API (OpenAI-compatible) — uncensored primary (MiniMax-M3).
# Use a Subscription/Token-Plan key (sk-cp-…); a pay-as-you-go sk-api- key needs
# balance. Base URL override is optional.
MINIMAX_API_KEY=
# ROUTER_MINIMAX_BASE_URL=https://api.minimax.io/v1
# Optional: env var name holding a key for the local Ollama (usually none).
# ROUTER_LOCAL_KEY_ENV=            # legacy: PF_MODELS_KEY_ENV

# ── Behaviour ────────────────────────────────────────────────────────
# Auto-inject an uncensored system overlay on *-uncensored-* tiers so clients
# don't each have to send one (models refuse bare explicit). On by default.
# ROUTER_AUTO_OVERLAY=0            # set to 0 to disable globally
# ROUTER_UNCENSORED_TEXT_OVERLAY=  # override the default text overlay
# ROUTER_UNCENSORED_VISION_OVERLAY=# override the default vision overlay
# ROUTER_OWNER=model-router        # `owned_by` shown in GET /v1/models
# ROUTER_CONFIG_PATH=              # optional JSON override of logical pools
# TTFB_TIMEOUT_MS=15000
# STREAM_IDLE_TIMEOUT_MS=30000
# PROBE_INTERVAL_SECONDS=60
# PROBE_TIMEOUT_MS=10000
# RETIREMENT_CHECK_INTERVAL_SECONDS=3600

# ── Protection: Metadata, Loop Guard & MiniMax Budget ───────────────
# Client metadata mode: soft (default, warns), enforce (400 if missing), off
# ROUTER_METADATA_MODE=soft
# Loop guard mode: enforce (default), dry-run, off
# ROUTER_LOOP_GUARD=enforce
# ROUTER_LOOP_MAX_REQ=40
# ROUTER_LOOP_REQ_WINDOW_SEC=300
# ROUTER_LOOP_MAX_TOKENS=3000000
# ROUTER_LOOP_TOKEN_WINDOW_SEC=600
# ROUTER_LOOP_MAX_REPEAT=3
# ROUTER_LOOP_BLOCK_SEC=600
# MiniMax credit budget (1.7B tokens / 30 days)
# ROUTER_MINIMAX_BUDGET_TOTAL=1700000000
# ROUTER_MINIMAX_CYCLE_START=2026-09-24
# ROUTER_MINIMAX_CYCLE_DAYS=30
# ROUTER_MINIMAX_TENANT_LIMITS={"master-service":{"day":30000000,"hour":6000000},"companion-app":{"day":15000000,"hour":3000000},"*":{"day":5000000,"hour":1000000}}
# State persistence directory for budget.json and requests/
# ROUTER_STATE_DIR=./data

# ── Admin Dashboard & Request Logging ─────────────────────────────────
# Password for /admin/ui and /admin/login. If unset, dashboard pages return 503.
# ROUTER_ADMIN_PASSWORD=
# Retention for daily request log files in days (default: 30)
# ROUTER_REQUEST_LOG_DAYS=30
# Preview characters of the last user prompt stored in log (default: 0 = none stored)
# ROUTER_LOG_PREVIEW_CHARS=0

# ── Notifications (Email + Telegram) ──────────────────────────────────
# ROUTER_NOTIFY=on                    # set to 'off' to disable all notifications
# ROUTER_ADMIN_EMAIL=admin@example.com
# ROUTER_ADMIN_TELEGRAM_CHAT_ID=123456789
# ROUTER_SMTP_HOST=smtp.example.com
# ROUTER_SMTP_PORT=465
# ROUTER_SMTP_SECURE=true
# ROUTER_SMTP_USER=router@example.com
# ROUTER_SMTP_PASS=secret
# ROUTER_SMTP_FROM=router@example.com
# ROUTER_TELEGRAM_BOT_TOKEN=123456:TEST-TOKEN
# ROUTER_NOTIFY_TENANTS=false         # if true, additionally sends tenant's events to tenant's own contacts
# ROUTER_NOTIFY_DEDUP_SEC=3600        # deduplication window in seconds (default: 3600)
# ROUTER_NOTIFY_MAX_PER_HOUR=30       # hard cap on messages per hour (0 = no cap)

# ── Deploy (compose) ─────────────────────────────────────────────────
# Name of the portal's existing docker network to attach to (see
# docker-compose.yml). Confirm with `docker network ls` on prod-host.
# ROUTER_PORTAL_NETWORK=portal_default

